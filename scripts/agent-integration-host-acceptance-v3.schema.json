{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidemind.ai/schemas/agent-integration-host-acceptance-v3.schema.json",
  "title": "Tide Mind real-host Agent Integration acceptance index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "acceptanceId",
    "evidenceClass",
    "appVersion",
    "upgradeFromAppVersions",
    "sourceCommit",
    "captureCreatedAt",
    "captureNonce",
    "generatedAt",
    "requirementsSha256",
    "releaseContractSha256",
    "candidateAppsByArchitecture",
    "review",
    "entries",
    "customPaths",
    "upgradePaths",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "acceptanceId": { "type": "string", "minLength": 1 },
    "evidenceClass": { "const": "real_host" },
    "appVersion": { "type": "string", "minLength": 1 },
    "upgradeFromAppVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "captureCreatedAt": { "type": "string", "format": "date-time" },
    "captureNonce": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "requirementsSha256": { "$ref": "#/$defs/sha256" },
    "releaseContractSha256": { "$ref": "#/$defs/sha256" },
    "candidateAppsByArchitecture": { "$ref": "#/$defs/candidateAppsByArchitecture" },
    "review": { "$ref": "#/$defs/review" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/acceptanceTarget" } },
    "customPaths": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/acceptanceTarget" } },
    "upgradePaths": { "type": "array", "items": { "$ref": "#/$defs/upgradePath" } },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assertionSource": { "enum": ["human", "external"] },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distributionId", "packageProvenance", "artifactReceiptSha256", "portableArtifactFingerprint", "executableSha256", "executableSizeBytes", "rawExecutableSha256", "rawExecutableSizeBytes", "distributionSha256", "distributionSizeBytes"],
      "properties": {
        "distributionId": { "type": "string", "minLength": 1 },
        "packageProvenance": { "type": "string", "minLength": 1 },
        "artifactReceiptSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "portableArtifactFingerprint": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "executableSizeBytes": { "type": "integer", "minimum": 1 },
        "rawExecutableSha256": { "$ref": "#/$defs/sha256" },
        "rawExecutableSizeBytes": { "type": "integer", "minimum": 1 },
        "distributionSha256": { "$ref": "#/$defs/sha256" },
        "distributionSizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "processArchitecture", "hardwareArchitecture", "translationMode", "osVersion", "hostIdentitySha256"],
      "properties": {
        "platform": { "const": "darwin" },
        "architecture": { "enum": ["arm64", "x64"] },
        "processArchitecture": { "enum": ["arm64", "x64"] },
        "hardwareArchitecture": { "enum": ["arm64", "x86_64"] },
        "translationMode": { "const": "not_translated" },
        "osVersion": { "type": "string", "minLength": 1 },
        "hostIdentitySha256": { "$ref": "#/$defs/sha256" }
      },
      "oneOf": [
        {
          "properties": {
            "architecture": { "const": "arm64" },
            "processArchitecture": { "const": "arm64" },
            "hardwareArchitecture": { "const": "arm64" }
          }
        },
        {
          "properties": {
            "architecture": { "const": "x64" },
            "processArchitecture": { "const": "x64" },
            "hardwareArchitecture": { "const": "x86_64" }
          }
        }
      ]
    },
    "customBinding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "sourceInstallationId", "sourceCatalogId", "configRootIdentitySha256", "configFileIdentitySha256", "selectorIdentitySha256", "executableFingerprint", "sourceLiveTrustProofSha256", "liveTrustProofSha256", "readBackProofSha256"],
      "properties": {
        "kind": { "enum": ["nonstandard_config_root", "manual_mcp_client"] },
        "sourceInstallationId": { "type": ["string", "null"], "minLength": 1 },
        "sourceCatalogId": { "type": ["string", "null"], "minLength": 1 },
        "configRootIdentitySha256": { "$ref": "#/$defs/sha256" },
        "configFileIdentitySha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "selectorIdentitySha256": { "$ref": "#/$defs/sha256" },
        "executableFingerprint": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "sourceLiveTrustProofSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "liveTrustProofSha256": { "$ref": "#/$defs/sha256" },
        "readBackProofSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "configurationOwnership": { "const": "user" },
        "activityBinding": { "$ref": "#/$defs/userOwnedCustomActivity" }
      },
      "allOf": [{
        "if": { "type": "object", "required": ["configurationOwnership"], "properties": { "configurationOwnership": { "const": "user" } } },
        "then": { "required": ["activityBinding"], "properties": {
          "kind": { "const": "manual_mcp_client" }, "configFileIdentitySha256": { "type": "null" },
          "readBackProofSha256": { "type": "null" }, "sourceInstallationId": { "type": "null" },
          "sourceCatalogId": { "type": "null" }, "sourceLiveTrustProofSha256": { "type": "null" },
          "executableFingerprint": { "$ref": "#/$defs/sha256" }
        } },
        "else": { "properties": { "readBackProofSha256": { "$ref": "#/$defs/sha256" } }, "not": { "type": "object", "required": ["activityBinding"] } }
      }]
    },
    "userOwnedCustomActivity": {
      "type": "object", "additionalProperties": false,
      "required": ["installationId", "agentId", "activationRunId", "generationSha256", "connectorConfigurationSha256", "runtimeBindingSha256", "tideMindVersion", "adapterVersion", "projectionVersion", "hostVersion", "schemaKind", "selectorKey", "evidence"],
      "properties": {
        "installationId": { "type": "string", "minLength": 1 }, "agentId": { "type": "string", "minLength": 1 },
        "activationRunId": { "type": "string", "minLength": 1 },
        "generationSha256": { "$ref": "#/$defs/sha256" }, "connectorConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "runtimeBindingSha256": { "$ref": "#/$defs/sha256" },
        "tideMindVersion": { "type": "string", "minLength": 1 }, "adapterVersion": { "type": "string", "minLength": 1 },
        "projectionVersion": { "type": "string", "minLength": 1 }, "hostVersion": { "type": "string", "minLength": 1 },
        "schemaKind": { "enum": ["standard_mcp_servers", "nested_mcp_servers", "opencode_mcp"] },
        "selectorKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$", "not": { "enum": ["__proto__", "prototype", "constructor"] } },
        "evidence": { "type": "array", "minItems": 2, "maxItems": 2, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "signalName", "evidenceHash", "observedAt"],
          "properties": { "id": { "type": "string", "pattern": "^aha_[a-f0-9]{24}$" },
            "signalName": { "enum": ["brain_recall", "brain_digest"] }, "evidenceHash": { "$ref": "#/$defs/sha256" },
            "observedAt": { "type": "string", "format": "date-time" } }
        } }
      }
    },
    "targetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetKey", "targetId", "hostVersion", "distribution", "environment", "installationId", "agentId"],
      "properties": {
        "targetKey": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "sourceCatalogId": { "type": "string", "minLength": 1 },
        "hostVersion": { "type": "string", "minLength": 1 },
        "distribution": { "$ref": "#/$defs/distribution" },
        "environment": { "$ref": "#/$defs/environment" },
        "installationId": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string", "minLength": 1 },
        "customBinding": { "$ref": "#/$defs/customBinding" }
      }
    },
    "targetMetadataExport": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["exporterVersion", "evidenceClass", "candidateBundleSha256", "sourceCommit", "releaseContractSha256", "targetMetadata", "exportedAt", "exportHash"],
      "properties": {
        "exporterVersion": { "const": 1 },
        "evidenceClass": { "enum": ["real_host", "fixture"] },
        "candidateBundleSha256": { "$ref": "#/$defs/sha256" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "releaseContractSha256": { "$ref": "#/$defs/sha256" },
        "targetMetadata": { "$ref": "#/$defs/targetMetadata" },
        "exportedAt": { "type": "string", "format": "date-time" },
        "exportHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidateApp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceCommit", "bundleSha256", "executableSha256", "teamId", "signingIdentity", "cdhash"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "bundleSha256": { "$ref": "#/$defs/sha256" },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "teamId": { "type": "string", "minLength": 1 },
        "signingIdentity": { "type": "string", "minLength": 1 },
        "cdhash": { "type": "string", "minLength": 1 }
      }
    },
    "candidateAppsByArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "arm64": { "$ref": "#/$defs/candidateApp" },
        "x64": { "$ref": "#/$defs/candidateApp" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewedAt", "decision", "evidenceManifestSha256", "candidateAppsSha256", "releaseContractSha256"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "decision": { "const": "approved" },
        "evidenceManifestSha256": { "$ref": "#/$defs/sha256" },
        "candidateAppsSha256": { "$ref": "#/$defs/sha256" },
        "releaseContractSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetKey", "targetId", "stepId", "appVersion", "sourceCommit", "candidateBundleSha256",
        "releaseContractSha256", "hostVersion", "installationId", "agentId", "evidenceIds", "outcomeDigest"
      ],
      "properties": {
        "targetKey": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "stepId": { "type": "string", "minLength": 1 },
        "appVersion": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "candidateBundleSha256": { "$ref": "#/$defs/sha256" },
        "releaseContractSha256": { "$ref": "#/$defs/sha256" },
        "hostVersion": { "type": "string", "minLength": 1 },
        "installationId": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "outcomeDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "observedAt", "assertionSource", "assertedBy", "assertions", "receipt", "evidenceFiles"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "const": "passed" },
        "observedAt": { "type": "string", "format": "date-time" },
        "assertionSource": { "$ref": "#/$defs/assertionSource" },
        "assertedBy": { "type": "string", "minLength": 1 },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "receipt": { "$ref": "#/$defs/receipt" },
        "evidenceFiles": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptanceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetKey", "targetId", "sourceCatalogId", "disposition", "targetCapability", "hostVersion", "distribution", "environment", "installationId", "agentId", "customBinding", "metadataExport", "steps"],
      "properties": {
        "targetKey": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "sourceCatalogId": { "type": ["string", "null"], "minLength": 1 },
        "disposition": { "enum": ["managed", "guided", "migration", "custom"] },
        "targetCapability": { "type": "integer", "minimum": 0, "maximum": 4 },
        "hostVersion": { "type": "string", "minLength": 1 },
        "distribution": { "$ref": "#/$defs/distribution" },
        "environment": { "$ref": "#/$defs/environment" },
        "installationId": { "type": "string", "minLength": 1 },
        "customBinding": { "$ref": "#/$defs/customBinding" },
        "metadataExport": { "$ref": "#/$defs/targetMetadataExport" },
        "agentId": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      }
    },
    "upgradeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetKey", "targetId", "fromAppVersion", "toAppVersion", "sourceCommit", "candidateBundleSha256",
        "releaseContractSha256", "targetIdentitySha256", "installationId", "originalAgentId", "migratedAgentId",
        "evidenceIds", "outcomeDigest"
      ],
      "properties": {
        "targetKey": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "fromAppVersion": { "type": "string", "minLength": 1 },
        "toAppVersion": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "candidateBundleSha256": { "$ref": "#/$defs/sha256" },
        "releaseContractSha256": { "$ref": "#/$defs/sha256" },
        "targetIdentitySha256": { "$ref": "#/$defs/sha256" },
        "installationId": { "type": "string", "minLength": 1 },
        "originalAgentId": { "type": "string", "minLength": 1 },
        "migratedAgentId": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "outcomeDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "upgradePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetKey", "targetId", "fromAppVersion", "toAppVersion", "status", "observedAt", "assertionSource", "assertedBy",
        "assertions", "installationId", "originalAgentId", "migratedAgentId", "historyPreserved",
        "statisticsPreserved", "targetIdentitySha256", "receipt", "evidenceFiles"
      ],
      "properties": {
        "targetKey": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "fromAppVersion": { "type": "string", "minLength": 1 },
        "toAppVersion": { "type": "string", "minLength": 1 },
        "status": { "const": "passed" },
        "observedAt": { "type": "string", "format": "date-time" },
        "assertionSource": { "$ref": "#/$defs/assertionSource" },
        "assertedBy": { "type": "string", "minLength": 1 },
        "assertions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "installationId": { "type": "string", "minLength": 1 },
        "originalAgentId": { "type": "string", "minLength": 1 },
        "migratedAgentId": { "type": "string", "minLength": 1 },
        "historyPreserved": { "const": true },
        "statisticsPreserved": { "const": true },
        "targetIdentitySha256": { "$ref": "#/$defs/sha256" },
        "receipt": { "$ref": "#/$defs/upgradeReceipt" },
        "evidenceFiles": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
