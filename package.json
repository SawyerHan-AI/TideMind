{
  "name": "tidemind",
  "version": "0.2.92",
  "description": "Tide Mind — 基于活图的认知系统，通过 MCP 协议为 AI 工具提供记忆服务",
  "type": "module",
  "bin": {
    "tidemind": "./dist/index.js",
    "tidemind-daemon": "./dist/daemon.js",
    "tidemind-hook": "./dist/hook-session-start.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "daemon": "tsx src/daemon.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:agent-integration-ui-e2e": "npm run build && npm --prefix client run build && TIDEMIND_UI_E2E_THEME=dark node scripts/run-agent-integration-electron-ui-e2e.mjs && TIDEMIND_UI_E2E_THEME=light node scripts/run-agent-integration-electron-ui-e2e.mjs",
    "audit:agent-integration-ui-e2e": "npm run build && npm --prefix client run build && TIDEMIND_UI_E2E_THEME=dark node scripts/run-agent-integration-electron-ui-e2e.mjs --keep && TIDEMIND_UI_E2E_THEME=light node scripts/run-agent-integration-electron-ui-e2e.mjs --keep",
    "measure:agent-integration": "node scripts/measure-agent-integration-performance.mjs",
    "verify:agent-integration-gates": "node scripts/verify-agent-integration-gate-receipts.mjs",
    "capture:agent-host-acceptance": "node scripts/capture-agent-integration-host-acceptance.mjs",
    "capture:agent-distribution-receipt": "tsx scripts/capture-agent-distribution-receipt.ts",
    "verify:agent-host-acceptance": "node scripts/verify-agent-integration-host-acceptance.mjs",
    "verify:agent-integration-release": "vitest run tests/client/agent-integration-release-manifest.test.ts --pool=forks --maxWorkers=1",
    "lint": "eslint src/",
    "measure:metabolism": "npm run build && node --expose-gc scripts/measure-metabolism-phase0.mjs --check docs/design/evidence/local-metabolism-performance-thresholds.json",
    "measure:metabolism:electron": "npm --prefix client run build:bin && node scripts/run-metabolism-worker-electron-performance.mjs",
    "measure:metabolism:packaged": "node scripts/run-packaged-metabolism-worker-performance.mjs",
    "smoke:packaged-metabolism": "npm run build && node scripts/smoke-packaged-metabolism-worker.mjs",
    "health": "node scripts/health-check.mjs",
    "release": "node scripts/release.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@anthropic-ai/vertex-sdk": "^0.16.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@notionhq/client": "^2.2.14",
    "@types/js-yaml": "^4.0.9",
    "better-sqlite3": "^12.9.0",
    "js-yaml": "^4.3.2",
    "nanoid": "^5.1.16",
    "protobufjs": "^7.6.5",
    "smol-toml": "^1.7.1",
    "sqlite-vec": "^0.1.7",
    "undici": "^7.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.1",
    "vite": "7.3.5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "gaxios": "^7.1.4",
    "esbuild": "^0.28.1"
  }
}
