{
  "name": "tidemind-client",
  "version": "0.2.38",
  "description": "Tide Mind 桌面客户端",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:bin && electron-vite dev",
    "build": "npm run build:bin && electron-vite build",
    "build:bin": "node scripts/build-bin.mjs",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --mac",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@types/d3": "^7.4.3",
    "@types/diff": "^7.0.2",
    "better-sqlite3": "^11.8.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "diff": "^8.0.4",
    "framer-motion": "^12.0.0",
    "i18next": "^26.0.4",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.3.0",
    "sqlite-vec": "^0.1.9",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.25.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
